      },
      "category_urls": [],
      "page_param": "currentPage",
      "max_pages": 25,
      "max_categories": 40,
      "selectors": {
        "link": "a[href*='/p/']",
        "item": ".product-grid__item, .js-product-container",
        "name": "[class*=name], a",
        "price": "[class*=price]"
      }
    },
    "leaflets": {
      "enabled": true,
      "pages": [
        "https://www.rimi.lt/asortimentas/rimi-savaitinis-leidinys"
