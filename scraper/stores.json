{
  "_pastaba": "Pirmas bandymas. Po paleidimo žiūrėk debug artefaktą: *_discover.txt (surastos nuorodos), leaflet_*.txt (leidinių puslapių nuorodos). Į leaflets.pdfs gali įrašyti tiesiogines PDF nuorodas.",
  "Maxima": {
    "catalog": {
      "enabled": false,
      "discover": {
        "url": "https://barbora.lt/",
        "regex": "^https://barbora\\.lt/[a-z0-9-]+$"
      },
      "category_urls": [
        "https://barbora.lt/darzoves-ir-vaisiai",
        "https://barbora.lt/pieno-produktai-ir-kiausiniai",
        "https://barbora.lt/mesa-zuvis-ir-kulinarija",
        "https://barbora.lt/duonos-gaminiai-ir-konditerija",
        "https://barbora.lt/bakaleja",
        "https://barbora.lt/saldytas-maistas",
        "https://barbora.lt/gerimai",
        "https://barbora.lt/kudikiu-prekes",
        "https://barbora.lt/higienos-ir-grozio-prekes",
        "https://barbora.lt/namu-kasdienybei"
      ],
      "page_param": "page",
      "max_pages": 40,
      "selectors": {
        "item": "[id^=fti-product], .b-product--wrap, li[class*=product]",
        "name": "[class*=title], [class*=name], a",
        "price": "[class*=price]",
        "link": "a[href*='/produktai/']"
      },
      "max_categories": 40
    },
    "leaflets": {
      "enabled": true,
      "pages": [
        "https://www.maxima.lt/leidiniai"
      ],
      "pdfs": [],
      "viewer_regex": "maxima\\.lt/leidiniai/[A-Za-z0-9_-]+"
    }
  },
  "Rimi": {
    "catalog": {
      "enabled": false,
      "discover": {
